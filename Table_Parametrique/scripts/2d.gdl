! ============================================================
!  SCRIPT 2D — symbole en plan
! ============================================================

PEN stylo

! --- Points chauds 2D (poignées d'étirement) ---
HOTSPOT2 0, 0
HOTSPOT2 A, 0
HOTSPOT2 0, B
HOTSPOT2 A, B
HOTSPOT2 A/2, B/2

! --- Contour du plateau ---
RECT2 0, 0, A, B

! --- Pieds (visibles sous le plateau) ---
LINE_TYPE 2	! trait caché
FOR i = 1 TO 4
	RECT2 px[i], py[i], px[i] + largPied, py[i] + largPied
NEXT i
